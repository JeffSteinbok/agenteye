{
  "name": "agenteye",
  "displayName": "AgentEye",
  "description": "Monitor your Copilot CLI and Claude Code sessions from VS Code",
  "publisher": "PUBLISHER_TBD",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:agenteye.status"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agenteye.openDashboard",
        "title": "AgentEye: Open Dashboard",
        "icon": "$(eye)"
      },
      {
        "command": "agenteye.stopBackend",
        "title": "AgentEye: Stop Backend"
      }
    ],
    "configuration": {
      "title": "AgentEye",
      "properties": {
        "agenteye.port": {
          "type": "number",
          "default": 5111,
          "scope": "application",
          "description": "Port for the AgentEye backend server"
        },
        "agenteye.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Path to Python or agenteye executable (auto-detected if empty)"
        },
        "agenteye.showStatusBar": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Show session count in the status bar (after first dashboard open)"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agenteye",
          "title": "AgentEye",
          "icon": "resources/eye.svg"
        }
      ]
    },
    "views": {
      "agenteye": [
        {
          "id": "agenteye.status",
          "name": "Dashboard"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agenteye.status",
        "contents": "Open the AgentEye dashboard to monitor your AI coding sessions.\n[Open Dashboard](command:agenteye.openDashboard)",
        "when": "!agenteye.dashboardOpen"
      },
      {
        "view": "agenteye.status",
        "contents": "AgentEye is connected.\n[Focus Dashboard](command:agenteye.openDashboard)",
        "when": "agenteye.dashboardOpen"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "test": "mocha --require ts-node/register --require src/test/vscode-mock.ts --ui tdd src/test/token.test.ts src/test/webview.test.ts",
    "lint": "eslint src/**/*.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "mocha": "^11.7.6",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
